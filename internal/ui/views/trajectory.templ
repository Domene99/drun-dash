package views

import "github.com/Domene99/drun-dash/internal/uikit"

// Trajectory renders the captured decision graph for a session: a readable
// heading (agent name when resolvable) with the session UUID as a secondary ID
// chip, a legend, then each event as an indented tree row showing the event
// type, a field/tool summary, the field_class as a status badge (structure vs
// payload), and the relative occurrence time (absolute on hover).
templ Trajectory(data TrajectoryData) {
	@Page(data.Chrome) {
		@uikit.PageHeader(uikit.PageHeaderConfig{
			Title:       data.Heading,
			Description: "The session's captured fork/rollback decision graph.",
			Action:      trajectoryBack(),
		})
		@uikit.Card(uikit.CardConfig{}) {
			<p>
				@uikit.IDChip(uikit.IDChipConfig{Label: "Session", ID: data.SessionID, Display: shortID(data.SessionID)})
			</p>
			<p class="uk-muted">
				@uikit.Badge(uikit.BadgeConfig{Variant: uikit.VariantInfo, Label: "structure"})
				<span>shape and metadata only</span>
				@uikit.Badge(uikit.BadgeConfig{Variant: uikit.VariantDanger, Label: "payload"})
				<span>raw value captured</span>
			</p>
			if data.Error != "" {
				@uikit.Alert(uikit.AlertConfig{Variant: uikit.VariantDanger}) {
					{ data.Error }
				}
			} else if len(data.Rows) == 0 {
				@uikit.EmptyState(uikit.EmptyStateConfig{
					Title:   "No trajectory events recorded",
					Message: "This session captured no decision-graph events.",
				})
			} else {
				@uikit.Table() {
					<thead>
						<tr>
							<th>Event</th>
							<th>Summary</th>
							<th>Class</th>
							<th>Occurred</th>
						</tr>
					</thead>
					<tbody>
						for _, ev := range data.Rows {
							<tr>
								<td>
									if ev.Indent != "" {
										<span class="uk-mono uk-muted">{ ev.Indent }</span>
									}
									{ ev.Type }
								</td>
								<td>{ ev.Summary }</td>
								<td>
									@uikit.StatusBadge(ev.FieldClass)
								</td>
								<td>
									@uikit.RelativeTime(uikit.RelativeTimeConfig{Relative: ev.Occurred.Relative, Absolute: ev.Occurred.Absolute})
								</td>
							</tr>
						}
					</tbody>
				}
			}
		}
	}
}

// trajectoryBack is the page-header action linking back to the Sessions list.
templ trajectoryBack() {
	@uikit.ButtonLink(uikit.ButtonLinkConfig{Variant: uikit.ButtonSecondary, Href: "/sessions"}) {
		Back to sessions
	}
}
