package views

import "github.com/Domene99/drun-dash/internal/uikit"

// Policies renders the policy catalog list — the entry point into the read-only
// policy detail views. Each policy is shown by name (linking to its detail),
// description, current version, and creation time.
templ Policies(data PoliciesData) {
	@Page(data.Chrome) {
		@uikit.PageHeader(uikit.PageHeaderConfig{
			Title:       "Policies",
			Description: "The policy boundaries that govern agent sessions.",
			Action:      policiesHeaderAction(data),
		})
		@uikit.Card(uikit.CardConfig{}) {
			if data.Error != "" {
				@uikit.Alert(uikit.AlertConfig{Variant: uikit.VariantDanger}) {
					{ data.Error }
				}
			}
			if len(data.Policies) == 0 {
				@uikit.EmptyState(uikit.EmptyStateConfig{
					Title:   "No policies yet",
					Message: "Policy boundaries defined in your organization will appear here.",
				})
			} else {
				@uikit.Table() {
					<thead>
						<tr>
							<th>Name</th>
							<th>Description</th>
							<th class="uk-num">Current version</th>
							<th>Created</th>
						</tr>
					</thead>
					<tbody>
						for _, p := range data.Policies {
							<tr>
								<td><a href={ templ.SafeURL(policyDetailPath(p.ID)) }>{ p.Name }</a></td>
								<td>{ orDash(p.Description) }</td>
								<td class="uk-num">{ p.CurrentVersion }</td>
								<td>
									@uikit.RelativeTime(uikit.RelativeTimeConfig{Relative: p.Created.Relative, Absolute: p.Created.Absolute})
								</td>
							</tr>
						}
					</tbody>
				}
			}
		}
		if data.CanManage {
			@policyCreateModal()
		}
	}
}

// policiesHeaderAction renders the New-policy button, but only for callers who
// may manage policies (policies.manage); otherwise it renders nothing.
templ policiesHeaderAction(data PoliciesData) {
	if data.CanManage {
		@uikit.Button(uikit.ButtonConfig{Variant: uikit.ButtonPrimary, Attrs: templ.Attributes{"data-uk-modal-open": "policy-create"}}) {
			New policy
		}
	}
}

// policyCreateModal renders the New-policy dialog: name, description, and the
// initial boundary (allowed tools, network posture, fan-out ceiling). It posts to
// /policies (POST /policies), which creates the policy and its version 1.
templ policyCreateModal() {
	@uikit.Modal(uikit.ModalConfig{ID: "policy-create", Title: "New policy"}) {
		<form method="post" action="/policies">
			@uikit.Field(uikit.FieldConfig{Label: "Name", For: "policy-name", Required: true}) {
				@uikit.Input(uikit.InputConfig{ID: "policy-name", Name: "name", Placeholder: "e.g. Read-only tools", Attrs: templ.Attributes{"required": true}})
			}
			@uikit.Field(uikit.FieldConfig{Label: "Description", For: "policy-description"}) {
				@uikit.Textarea(uikit.TextareaConfig{ID: "policy-description", Name: "description", Rows: 2, Placeholder: "What this boundary enforces."})
			}
			@uikit.Field(uikit.FieldConfig{Label: "Allowed tools", For: "policy-allowed-tools", Help: "Tool identifiers agents may invoke under this boundary, one per line or comma-separated. Leave empty to allow none."}) {
				@uikit.Textarea(uikit.TextareaConfig{ID: "policy-allowed-tools", Name: "allowed_tools", Rows: 3, Placeholder: "search\nfetch"})
			}
			@uikit.Field(uikit.FieldConfig{Label: "Network", For: "policy-network", Help: "Network egress posture for sessions under this boundary."}) {
				@uikit.Select(uikit.SelectConfig{ID: "policy-network", Name: "network"}) {
					<option value="none">none</option>
					<option value="allowlist">allowlist</option>
					<option value="unrestricted">unrestricted</option>
				}
			}
			@uikit.Field(uikit.FieldConfig{Label: "Fan-out ceiling", For: "policy-fan-out", Help: "Default ceiling on concurrent sub-agents. Leave blank for the engine default."}) {
				@uikit.Input(uikit.InputConfig{ID: "policy-fan-out", Name: "fan_out_ceiling", Type: "number", Attrs: templ.Attributes{"min": "0", "step": "1"}})
			}
			<div class="uk-modal-footer">
				@uikit.Button(uikit.ButtonConfig{Variant: uikit.ButtonSecondary, Attrs: templ.Attributes{"data-uk-modal-close": true}}) {
					Cancel
				}
				@uikit.Button(uikit.ButtonConfig{Variant: uikit.ButtonPrimary, Type: "submit"}) {
					Create policy
				}
			</div>
		</form>
	}
}

// PolicyDetail renders the read-only detail view for one policy: its metadata
// (description, current version, created) and its immutable signed versions, each
// by version number, content digest (as an ID chip), signing provenance, and
// creation time.
templ PolicyDetail(data PolicyDetailData) {
	@Page(data.Chrome) {
		@uikit.PageHeader(uikit.PageHeaderConfig{
			Title:       orDash(data.Name),
			Description: "Policy detail — read only.",
			Action:      policyDetailBack(),
		})
		if data.Error != "" {
			@uikit.Card(uikit.CardConfig{}) {
				@uikit.Alert(uikit.AlertConfig{Variant: uikit.VariantDanger}) {
					{ data.Error }
				}
			}
		} else {
			@uikit.Card(uikit.CardConfig{Title: "Overview"}) {
				<p>{ orDash(data.Description) }</p>
				@detailRow("Policy") {
					@uikit.IDChip(uikit.IDChipConfig{ID: data.ID, Display: shortID(data.ID)})
				}
				@detailRow("Current version") {
					{ data.CurrentVersion }
				}
				@detailRow("Created") {
					@uikit.RelativeTime(uikit.RelativeTimeConfig{Relative: data.Created.Relative, Absolute: data.Created.Absolute})
				}
			}
			@uikit.Card(uikit.CardConfig{Title: "Versions"}) {
				if len(data.Versions) == 0 {
					@uikit.EmptyState(uikit.EmptyStateConfig{
						Title:   "No versions",
						Message: "This policy has no published versions yet.",
					})
				} else {
					@uikit.Table() {
						<thead>
							<tr>
								<th class="uk-num">Version</th>
								<th>Digest</th>
								<th>Algorithm</th>
								<th>Key ID</th>
								<th>Created</th>
							</tr>
						</thead>
						<tbody>
							for _, v := range data.Versions {
								<tr>
									<td class="uk-num">{ v.Version }</td>
									<td>
										if v.Digest != "" {
											@uikit.IDChip(uikit.IDChipConfig{ID: v.Digest, Display: shortID(v.Digest)})
										} else {
											<span class="uk-muted">—</span>
										}
									</td>
									<td>{ orDash(v.Algorithm) }</td>
									<td>{ orDash(v.KeyID) }</td>
									<td>
										@uikit.RelativeTime(uikit.RelativeTimeConfig{Relative: v.Created.Relative, Absolute: v.Created.Absolute})
									</td>
								</tr>
							}
						</tbody>
					}
				}
			}
		}
	}
}

// policyDetailBack is the policy-detail page-header action linking back to the
// policy list.
templ policyDetailBack() {
	@uikit.ButtonLink(uikit.ButtonLinkConfig{Variant: uikit.ButtonSecondary, Href: "/policies"}) {
		Back to policies
	}
}
