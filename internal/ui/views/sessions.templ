package views

import "github.com/Domene99/drun-dash/internal/uikit"

// Sessions renders the flight-recorder view: every governed session by agent
// name + status badge + relative start + fan-out, with the session UUID as a
// copyable secondary ID chip (never the primary label — ADR-0005 §4) and a link
// into the trajectory viewer.
templ Sessions(data SessionsData) {
	@Page(data.Chrome) {
		@uikit.PageHeader(uikit.PageHeaderConfig{
			Title:       "Sessions",
			Description: "Governed agent sessions across your organization.",
		})
		@uikit.Card(uikit.CardConfig{}) {
			if data.Error != "" {
				@uikit.Alert(uikit.AlertConfig{Variant: uikit.VariantDanger}) {
					{ data.Error }
				}
			} else if len(data.Sessions) == 0 {
				@uikit.EmptyState(uikit.EmptyStateConfig{
					Title:   "No sessions yet",
					Message: "Governed agent sessions will appear here once launched.",
				})
			} else {
				@uikit.Table() {
					<thead>
						<tr>
							<th>Agent</th>
							<th>Status</th>
							<th>Started</th>
							<th class="uk-num">Fan-out</th>
							<th>Session</th>
							<th></th>
						</tr>
					</thead>
					<tbody>
						for _, s := range data.Sessions {
							<tr>
								<td>{ s.Agent }</td>
								<td>
									@uikit.StatusBadge(s.Status)
								</td>
								<td>
									@uikit.RelativeTime(uikit.RelativeTimeConfig{Relative: s.Started.Relative, Absolute: s.Started.Absolute})
								</td>
								<td class="uk-num">{ s.FanOut }</td>
								<td>
									@uikit.IDChip(uikit.IDChipConfig{ID: s.ID, Display: shortID(s.ID)})
								</td>
								<td>
									@uikit.ButtonLink(uikit.ButtonLinkConfig{Variant: uikit.ButtonGhost, Small: true, Href: trajectoryPath(s.ID)}) {
										View trajectory
									}
								</td>
							</tr>
						}
					</tbody>
				}
			}
		}
	}
}
