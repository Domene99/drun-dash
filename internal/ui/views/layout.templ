package views

import "github.com/Domene99/drun-dash/internal/uikit"

// Page is the base shell for every authenticated admin page. It composes the
// shared uikit [uikit.Shell] — a persistent left sidebar (grouped nav with the
// active section marked), a top bar (org word-mark, environment indicator,
// dark-mode toggle, and a user menu carrying the signed-in identity and
// sign-out) — and yields the page content via templ's children. This replaces
// the old flat four-link top nav and the inline <style> block.
templ Page(chrome Chrome) {
	@uikit.Shell(uikit.ShellConfig{
		Head: uikit.Head(uikit.HeadConfig{Title: chrome.Title}),
		Sidebar: uikit.Sidebar(uikit.SidebarConfig{
			Brand:     "drun-dash",
			BrandHref: "/",
			Groups:    navGroups(chrome.Active),
		}),
		TopBar: uikit.TopBar(uikit.TopBarConfig{
			OrgName:     "drun-dash",
			Environment: chrome.Environment,
			UserMenu:    userMenu(chrome.Identity),
		}),
	}) {
		{ children... }
	}
}

// Minimal is the sidebar-less shell used by the pre-app pages (login) and the
// focused device-approval confirmation: the shared top bar (word-mark + theme
// toggle, no user menu) over full-width content.
templ Minimal(title string) {
	@uikit.Shell(uikit.ShellConfig{
		Head:   uikit.Head(uikit.HeadConfig{Title: title}),
		TopBar: uikit.TopBar(uikit.TopBarConfig{OrgName: "drun-dash"}),
	}) {
		{ children... }
	}
}

// userMenu renders the top-bar profile menu: a disclosure whose summary is a
// ghost button and whose panel is a card carrying the signed-in identity. The
// visible identity is plain text — the member's name and email ("Name — email")
// and the organization NAME (ADR-0005 §4) — never the raw "local:<uuid>" subject
// or org UUID as a primary label. Those raw ids stay only as subtle, copyable ID
// chips (and the subject as the summary's hover title) for developer support,
// alongside the sign-out action.
templ userMenu(id IdentityView) {
	<details class="uk-user-menu">
		<summary class="uk-btn uk-btn--ghost" title={ id.Subject }>{ userMenuLabel(id) }</summary>
		@uikit.Card(uikit.CardConfig{Title: "Signed in"}) {
			<p>{ identityPrimary(id) }</p>
			if id.OrgName != "" {
				<p class="uk-muted">{ id.OrgName }</p>
			}
			<p class="uk-muted">Roles: { orDash(id.Roles) }</p>
			if id.Subject != "" {
				<p>@uikit.IDChip(uikit.IDChipConfig{Label: "Subject", ID: id.Subject, Display: shortID(id.Subject)})</p>
			}
			if id.OrganizationID != "" {
				<p>@uikit.IDChip(uikit.IDChipConfig{Label: "Org", ID: id.OrganizationID, Display: shortID(id.OrganizationID)})</p>
			}
			<form method="post" action="/logout">
				@uikit.Button(uikit.ButtonConfig{Variant: uikit.ButtonSecondary, Type: "submit"}) {
					Sign out
				}
			</form>
		}
	</details>
}

// userMenuLabel is the collapsed user-menu label: the member's name, else their
// email, else a neutral "Account" — never the raw subject UUID.
func userMenuLabel(id IdentityView) string {
	switch {
	case id.Name != "":
		return id.Name
	case id.Email != "":
		return id.Email
	default:
		return "Account"
	}
}

// identityPrimary is the primary identity line in the user menu: the member's
// name and email ("Name — email") when both are known, otherwise whichever is
// present (the email alone if there is no name), so the visible identity reads as
// a person — never a "local:<uuid>" subject.
func identityPrimary(id IdentityView) string {
	switch {
	case id.Name != "" && id.Email != "":
		return id.Name + " — " + id.Email
	case id.Name != "":
		return id.Name
	case id.Email != "":
		return id.Email
	default:
		return "Account"
	}
}
