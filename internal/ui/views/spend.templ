package views

import "github.com/Domene99/drun-dash/internal/uikit"

// Spend renders the finance view: the spend total over the window as a metric,
// the per-agent breakdown, and configured budgets with their utilization (a
// budget at or over its limit is flagged with a danger badge). The spend and
// budgets sections fail independently, each surfacing its own inline error.
templ Spend(data SpendPageData) {
	@Page(data.Chrome) {
		@uikit.PageHeader(uikit.PageHeaderConfig{
			Title:       "Spend",
			Description: "Spend " + data.Window + " by agent, with budget utilization.",
		})
		@uikit.Card(uikit.CardConfig{Title: "Total spend " + data.Window}) {
			@uikit.Metrics([]uikit.Metric{
				{Label: "Total", Value: data.Total},
			})
			if data.SpendError != "" {
				@uikit.Alert(uikit.AlertConfig{Variant: uikit.VariantDanger}) {
					{ data.SpendError }
				}
			} else if len(data.Groups) == 0 {
				@uikit.EmptyState(uikit.EmptyStateConfig{
					Title:   "No spend in this window",
					Message: "Agent spend will appear here once sessions run.",
				})
			} else {
				@uikit.Table() {
					<thead>
						<tr>
							<th>Agent</th>
							<th class="uk-num">Amount</th>
							<th class="uk-num">Tokens</th>
						</tr>
					</thead>
					<tbody>
						for _, g := range data.Groups {
							<tr>
								<td>{ g.Key }</td>
								<td class="uk-num">{ g.Amount }</td>
								<td class="uk-num">{ g.Tokens }</td>
							</tr>
						}
					</tbody>
				}
			}
		}
		@uikit.Card(uikit.CardConfig{Title: "Budgets"}) {
			if data.BudgetsError != "" {
				@uikit.Alert(uikit.AlertConfig{Variant: uikit.VariantDanger}) {
					{ data.BudgetsError }
				}
			} else if len(data.Budgets) == 0 {
				@uikit.EmptyState(uikit.EmptyStateConfig{
					Title:   "No budgets configured",
					Message: "Configured spend budgets and their utilization will appear here.",
				})
			} else {
				@uikit.Table() {
					<thead>
						<tr>
							<th>Budget</th>
							<th>Period</th>
							<th class="uk-num">Spent</th>
							<th class="uk-num">Limit</th>
							<th class="uk-num">Utilization</th>
						</tr>
					</thead>
					<tbody>
						for _, b := range data.Budgets {
							<tr>
								<td>{ b.Name }</td>
								<td>{ b.Period }</td>
								<td class="uk-num">{ b.Spent }</td>
								<td class="uk-num">{ b.Limit }</td>
								<td class="uk-num">
									if b.Over {
										@uikit.Badge(uikit.BadgeConfig{Variant: uikit.VariantDanger, Label: b.Utilization})
									} else {
										{ b.Utilization }
									}
								</td>
							</tr>
						}
					</tbody>
				}
			}
		}
	}
}
