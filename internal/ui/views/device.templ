package views

import "github.com/Domene99/drun-dash/internal/uikit"

// Device renders the device-approval confirmation page that completes the CLI
// `drun-dash login` device flow, in the sidebar-less [Minimal] shell. It shows
// the user code so the operator can confirm it matches their terminal, then
// approve (primary) or deny (danger). Once a decision is recorded it renders a
// short confirmation.
templ Device(data DeviceData) {
	@Minimal("Approve device") {
		@uikit.PageHeader(uikit.PageHeaderConfig{
			Title:       "Approve device login",
			Description: "Confirm the code matches your terminal, then approve or deny.",
		})
		@uikit.Card(uikit.CardConfig{}) {
			if data.Error != "" {
				@uikit.Alert(uikit.AlertConfig{Variant: uikit.VariantDanger}) {
					{ data.Error }
				}
			}
			if data.Done {
				if data.Approved {
					@uikit.Alert(uikit.AlertConfig{Variant: uikit.VariantSuccess, Title: "Device approved"}) {
						Device <code class="uk-mono">{ data.UserCode }</code> approved. Return to
						your terminal — the CLI will finish signing in.
					}
				} else {
					@uikit.Alert(uikit.AlertConfig{Variant: uikit.VariantNeutral, Title: "Device denied"}) {
						Device request <code class="uk-mono">{ data.UserCode }</code> denied.
					}
				}
			} else if data.UserCode != "" {
				<p class="uk-muted">
					A device is requesting access to your organization. Confirm the code
					below matches the one shown in your terminal, then approve or deny.
				</p>
				<p class="uk-metric-value uk-mono">{ data.UserCode }</p>
				<form method="post" action="/device" class="uk-row-actions">
					<input type="hidden" name="user_code" value={ data.UserCode }/>
					@uikit.Button(uikit.ButtonConfig{
						Variant: uikit.ButtonPrimary,
						Type:    "submit",
						Attrs:   templ.Attributes{"name": "decision", "value": "approve"},
					}) {
						Approve
					}
					@uikit.Button(uikit.ButtonConfig{
						Variant: uikit.ButtonDanger,
						Type:    "submit",
						Attrs:   templ.Attributes{"name": "decision", "value": "deny"},
					}) {
						Deny
					}
				</form>
			}
		}
	}
}
