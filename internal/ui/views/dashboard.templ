package views

import "github.com/Domene99/drun-dash/internal/uikit"

// Dashboard renders the Overview page (ADR-0005 §4): a meaningful summary of
// what is happening in the org — metric cards and a recent-activity list — in
// place of the old JWT-claims dump (which now lives in the top-bar user menu).
templ Dashboard(data DashboardData) {
	@Page(data.Chrome) {
		@uikit.PageHeader(uikit.PageHeaderConfig{
			Title:       "Overview",
			Description: "What's happening across your organization right now.",
		})
		@Summary(data.Summary)
	}
}

// Summary renders the live overview. Its root element carries the HTMX
// attributes that poll GET /fragments/summary every 30 seconds and swap
// themselves (outerHTML) with the fresh fragment, so the same handler serves
// both the initial embed and each refresh.
templ Summary(data SummaryData) {
	<section id="summary" hx-get="/fragments/summary" hx-trigger="every 30s" hx-swap="outerHTML">
		@uikit.Metrics([]uikit.Metric{
			{Label: "Active sessions", Value: data.ActiveSessions},
			{Label: "Pending approvals", Value: data.PendingApprovals},
			{Label: "Spend " + data.SpendWindow, Value: data.SpendTotal},
			{Label: "Agents", Value: data.AgentCount},
		})
		@uikit.Card(uikit.CardConfig{Title: "Recent sessions", Action: summaryRefresh()}) {
			if data.SessionsError != "" {
				@uikit.Alert(uikit.AlertConfig{Variant: uikit.VariantDanger}) {
					{ data.SessionsError }
				}
			} else if len(data.RecentSessions) == 0 {
				@uikit.EmptyState(uikit.EmptyStateConfig{
					Title:   "No sessions yet",
					Message: "Launched agent sessions will appear here.",
				})
			} else {
				@uikit.Table() {
					<thead>
						<tr>
							<th>Agent</th>
							<th>Status</th>
							<th>Started</th>
							<th>Session</th>
						</tr>
					</thead>
					<tbody>
						for _, s := range data.RecentSessions {
							<tr>
								<td>{ s.Agent }</td>
								<td>
									@uikit.StatusBadge(s.Status)
								</td>
								<td>
									@uikit.RelativeTime(uikit.RelativeTimeConfig{Relative: s.Started.Relative, Absolute: s.Started.Absolute})
								</td>
								<td>
									@uikit.IDChip(uikit.IDChipConfig{ID: s.ID, Display: shortID(s.ID)})
								</td>
							</tr>
						}
					</tbody>
				}
			}
		}
	</section>
}

// summaryRefresh is the visible Refresh control in the recent-sessions card
// header — a ghost button that re-requests the summary fragment (the direct fix
// for the old invisible-until-hover Refresh control).
templ summaryRefresh() {
	@uikit.Button(uikit.ButtonConfig{
		Variant: uikit.ButtonGhost,
		Small:   true,
		Attrs: templ.Attributes{
			"hx-get":    "/fragments/summary",
			"hx-target": "#summary",
			"hx-swap":   "outerHTML",
		},
	}) {
		Refresh
	}
}
