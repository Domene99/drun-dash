package views

import "github.com/Domene99/drun-dash/internal/uikit"

// Approvals renders the escalation queue by readable action + reason + status
// badge + relative time, with the session UUID as a copyable secondary ID chip.
// Each row is emitted by [ApprovalRowTr] so the same markup serves both the
// initial table and the HTMX row-swap after a decision.
templ Approvals(data ApprovalsData) {
	@Page(data.Chrome) {
		@uikit.PageHeader(uikit.PageHeaderConfig{
			Title:       "Approvals",
			Description: "The escalation inbox — decisions awaiting your review.",
		})
		@uikit.Card(uikit.CardConfig{}) {
			if data.Error != "" {
				@uikit.Alert(uikit.AlertConfig{Variant: uikit.VariantDanger}) {
					{ data.Error }
				}
			} else if len(data.Approvals) == 0 {
				@uikit.EmptyState(uikit.EmptyStateConfig{
					Title:   "No approval requests",
					Message: "Escalations that need a decision will appear here.",
				})
			} else {
				@uikit.Table() {
					<thead>
						<tr>
							<th>Action</th>
							<th>Reason</th>
							<th>Status</th>
							<th>Decided by</th>
							<th>Created</th>
							<th>Session</th>
							<th>Decision</th>
						</tr>
					</thead>
					<tbody>
						for _, a := range data.Approvals {
							@ApprovalRowTr(a)
						}
					</tbody>
				}
			}
		}
	}
}

// ApprovalRowTr renders a single approvals table row. A pending row offers
// clearly-visible Approve (primary) and Deny (danger) buttons that HTMX-POST to
// the decision handler and swap this same <tr> (outerHTML); a decided row is
// read-only. The stable id lets the swap target the row precisely.
templ ApprovalRowTr(row ApprovalRow) {
	<tr id={ "approval-" + row.ID }>
		<td>{ row.Action }</td>
		<td>{ orDash(row.Reason) }</td>
		<td>
			@uikit.StatusBadge(row.Status)
		</td>
		<td>{ orDash(row.DecidedBy) }</td>
		<td>
			@uikit.RelativeTime(uikit.RelativeTimeConfig{Relative: row.Created.Relative, Absolute: row.Created.Absolute})
		</td>
		<td>
			@uikit.IDChip(uikit.IDChipConfig{ID: row.Session, Display: shortID(row.Session)})
		</td>
		<td>
			if row.RowError != "" {
				<span class="uk-error" role="alert">{ row.RowError }</span>
			} else if row.Pending {
				<div class="uk-row-actions">
					@uikit.Button(uikit.ButtonConfig{
						Variant: uikit.ButtonPrimary,
						Small:   true,
						Attrs: templ.Attributes{
							"hx-post":   decisionPath(row.ID),
							"hx-vals":   `{"decision":"approve"}`,
							"hx-target": "closest tr",
							"hx-swap":   "outerHTML",
						},
					}) {
						Approve
					}
					@uikit.Button(uikit.ButtonConfig{
						Variant: uikit.ButtonDanger,
						Small:   true,
						Attrs: templ.Attributes{
							"hx-post":   decisionPath(row.ID),
							"hx-vals":   `{"decision":"deny"}`,
							"hx-target": "closest tr",
							"hx-swap":   "outerHTML",
						},
					}) {
						Deny
					}
				</div>
			} else {
				<span class="uk-muted">—</span>
			}
		</td>
	</tr>
}
