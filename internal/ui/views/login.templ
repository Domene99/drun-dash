package views

import "github.com/Domene99/drun-dash/internal/uikit"

// Login renders the sign-in page in the sidebar-less [Minimal] shell. With OIDC
// configured the operator is normally redirected straight to the identity
// provider by GET /login; this page offers a retry button after a failed
// callback. Without OIDC it renders the paste-a-token dev form.
templ Login(data LoginData) {
	@Minimal("Sign in") {
		@uikit.PageHeader(uikit.PageHeaderConfig{
			Title:       "Sign in",
			Description: "Access the drun-dash governance console.",
		})
		@uikit.Card(uikit.CardConfig{}) {
			if data.Error != "" {
				@uikit.Alert(uikit.AlertConfig{Variant: uikit.VariantDanger}) {
					{ data.Error }
				}
			}
			if data.OIDC {
				<p class="uk-muted">
					Sign in with your organization's identity provider to open the
					dashboard.
				</p>
				@uikit.ButtonLink(uikit.ButtonLinkConfig{Variant: uikit.ButtonPrimary, Href: "/login"}) {
					Sign in with your identity provider
				}
			} else {
				<p class="uk-muted">
					Paste a control-plane session token to open the dashboard. Obtain one
					out-of-band with <code class="uk-mono">drun-dash login</code> or by
					calling <code class="uk-mono">POST /auth/session</code>.
				</p>
				<form method="post" action="/login">
					@uikit.Field(uikit.FieldConfig{Label: "Session token", For: "token"}) {
						@uikit.Textarea(uikit.TextareaConfig{
							ID:          "token",
							Name:        "token",
							Rows:        4,
							Placeholder: "eyJhbGciOi...",
							Attrs:       templ.Attributes{"required": true, "autofocus": true},
						})
					}
					@uikit.Button(uikit.ButtonConfig{Variant: uikit.ButtonPrimary, Type: "submit"}) {
						Sign in
					}
				</form>
			}
		}
	}
}
