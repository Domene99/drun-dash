// Package views holds the server-rendered templ components for the drun-dash
// member console: the shared HTML layout, the device-flow login page, and the
// entitled-agent home page.
//
// Views are pure presentation. They receive fully-resolved view models (plain
// strings and slices assembled by internal/memberui) and never call the control
// plane or import internal/memberui, so the dependency edge runs one way
// (internal/memberui -> views) and stays cycle-free.
//
// The *.templ files are the source of truth; the committed *_templ.go files are
// generated from them with `templ generate` (see internal/memberui/README.md).
// Edit the .templ file and regenerate — never hand-edit the generated Go.
package views

// htmxScriptURL is the CDN location of the HTMX runtime pulled into every page
// by [Layout]. HTMX powers the login page's approval poller and the home page's
// launch/terminate section swaps; pinning an exact version keeps behavior
// reproducible. Swap this for a vendored asset if serving from a CDN is
// undesirable in your deployment.
const htmxScriptURL = "https://cdn.jsdelivr.net/npm/htmx.org@2.0.4/dist/htmx.min.js"

// Layout is the base HTML shell shared by every member-console page. It renders
// the document head (including the HTMX script and minimal styling) and a top
// bar, then yields to the caller-supplied body via templ's children mechanism.
// showNav toggles the signed-in navigation (a Sign out button); the login page
// passes false.
templ Layout(title string, showNav bool) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } · drun-dash member console</title>
			<script src={ htmxScriptURL } defer></script>
			<style>
				:root { color-scheme: light dark; }
				* { box-sizing: border-box; }
				body {
					margin: 0;
					font-family: system-ui, -apple-system, Segoe UI, Roboto, sans-serif;
					line-height: 1.5;
					background: #f6f7f9;
					color: #1c2430;
				}
				.topnav {
					display: flex;
					align-items: center;
					gap: 1.5rem;
					padding: 0.75rem 1.5rem;
					background: #0f1b2d;
					color: #fff;
				}
				.topnav .brand { font-weight: 700; letter-spacing: 0.02em; }
				.topnav form.logout { margin-left: auto; }
				.topnav button {
					background: transparent;
					border: 1px solid #35506f;
					color: #cdd7e5;
					border-radius: 4px;
					padding: 0.3rem 0.75rem;
					cursor: pointer;
				}
				main { max-width: 60rem; margin: 1.5rem auto; padding: 0 1.5rem; }
				.card {
					background: #fff;
					border: 1px solid #e2e6eb;
					border-radius: 8px;
					padding: 1.25rem;
					margin-bottom: 1.25rem;
				}
				h1 { font-size: 1.4rem; margin: 0 0 0.75rem; }
				h2 { font-size: 1.1rem; margin: 0 0 0.5rem; }
				.muted { color: #667085; }
				.error { color: #b42318; font-weight: 600; }
				.code {
					font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
					font-size: 1.8rem;
					font-weight: 700;
					letter-spacing: 0.15em;
				}
				table { width: 100%; border-collapse: collapse; margin-top: 0.5rem; }
				th, td { text-align: left; padding: 0.4rem 0.5rem; border-bottom: 1px solid #eceff3; font-size: 0.9rem; }
				th { color: #667085; font-weight: 600; }
				td.num { text-align: right; font-variant-numeric: tabular-nums; }
				td.mono { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.82rem; }
				button {
					border: 1px solid #cbd5e1;
					background: #fff;
					border-radius: 4px;
					padding: 0.3rem 0.85rem;
					cursor: pointer;
					font-size: 0.85rem;
				}
				button.primary { background: #1d4ed8; color: #fff; border: 0; }
				button.deny { border-color: #f0c2bc; color: #b42318; }
			</style>
		</head>
		<body>
			<header class="topnav">
				<span class="brand">drun-dash · member console</span>
				if showNav {
					<form method="post" action="/logout" class="logout">
						<button type="submit">Sign out</button>
					</form>
				}
			</header>
			<main>
				{ children... }
			</main>
		</body>
	</html>
}
