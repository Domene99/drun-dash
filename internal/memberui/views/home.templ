package views

import "github.com/Domene99/drun-dash/internal/uikit"

// Home renders the chat-first landing page (ADR-0005 §3, ADR-0007 §4): an agent
// picker as the entry point — the member's runnable agents, each with a Start
// action that launches a governed session and drops straight into the chat —
// over [SessionsSection], the prior conversations they can reopen. The landing
// experience is "pick an agent and chat," not a bare table.
templ Home(data HomeData) {
	@Layout("Agents", true) {
		@uikit.PageHeader(uikit.PageHeaderConfig{
			Title:       "Start a conversation",
			Description: "Pick an agent to launch a governed session and drop straight into the chat.",
		})
		@uikit.Card(uikit.CardConfig{Title: "Agents you can launch"}) {
			if data.AgentsError != "" {
				@uikit.Alert(uikit.AlertConfig{Variant: uikit.VariantDanger, Title: "Could not load agents"}) {
					{ data.AgentsError }
				}
			} else if len(data.Agents) == 0 {
				@uikit.EmptyState(uikit.EmptyStateConfig{
					Title:   "No agents yet",
					Message: "No agents are available to you yet. Ask an admin to grant you access.",
				})
			} else {
				<p class="uk-muted mc-workdir-help">
					Working directory: the folder the agent works in. It's mounted into the sandbox; changes only reach these files when you review the diff and click Commit. Leave blank for a scratch sandbox.
				</p>
				@uikit.Table() {
					<thead>
						<tr>
							<th>Agent</th>
							<th class="uk-num">Version</th>
							<th>Description</th>
							<th>Working directory</th>
							<th></th>
						</tr>
					</thead>
					<tbody>
						for _, a := range data.Agents {
							<tr>
								<td>{ a.Name }</td>
								<td class="uk-num">{ a.Version }</td>
								<td class="uk-muted">{ a.Description }</td>
								<td colspan="2">
									<form class="mc-launch" hx-post="/sessions" hx-target="#sessions" hx-swap="outerHTML">
										<input type="hidden" name="agent_id" value={ a.ID }/>
										<input type="hidden" name="agent_name" value={ a.Name }/>
										<input
											type="text"
											name="working_dir"
											class="uk-input uk-input--sm mc-workdir-input"
											placeholder="/Users/you/project (optional)"
											title="The folder the agent works in. It's mounted into the sandbox; changes only reach these files when you review the diff and click Commit. Leave blank for a scratch sandbox."
											autocapitalize="off"
											autocorrect="off"
											autocomplete="off"
											spellcheck="false"
										/>
										@uikit.Button(uikit.ButtonConfig{Variant: uikit.ButtonPrimary, Type: "submit", Small: true}) {
											Start chat
										}
									</form>
								</td>
							</tr>
						}
					</tbody>
				}
			}
		}
		@SessionsSection(SessionsData{Sessions: data.Sessions})
	}
}

// SessionsSection renders the session-history table: the conversations this
// console has launched, each reopenable from its agent name. It is a standalone
// component with a stable id so the launch and terminate actions swap just this
// section via HTMX. The proxy token is never shown; the raw session UUID appears
// only as a copyable ID chip (ADR-0005 §4), never as the primary label.
templ SessionsSection(data SessionsData) {
	<section class="uk-card" id="sessions">
		<div class="uk-card-header">
			<h2>Your conversations</h2>
		</div>
		if data.Error != "" {
			@uikit.Alert(uikit.AlertConfig{Variant: uikit.VariantDanger}) {
				{ data.Error }
			}
		}
		if len(data.Sessions) == 0 {
			@uikit.EmptyState(uikit.EmptyStateConfig{
				Title:   "No conversations yet",
				Message: "Launch an agent above to start one.",
			})
		} else {
			@uikit.Table() {
				<thead>
					<tr>
						<th>Agent</th>
						<th>Session</th>
						<th class="uk-num">Fan-out</th>
						<th>Expires</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					for _, s := range data.Sessions {
						<tr>
							<td><a href={ templ.SafeURL(runPath(s.ID)) }>{ s.Agent }</a></td>
							<td>
								@uikit.IDChip(uikit.IDChipConfig{ID: s.ID, Display: shortID(s.ID)})
							</td>
							<td class="uk-num">{ s.FanOut }</td>
							<td class="uk-muted">{ s.Expires }</td>
							<td class="uk-row-actions">
								@uikit.ButtonLink(uikit.ButtonLinkConfig{Variant: uikit.ButtonSecondary, Small: true, Href: runPath(s.ID)}) {
									Open
								}
								<form hx-post={ terminatePath(s.ID) } hx-target="#sessions" hx-swap="outerHTML">
									@uikit.Button(uikit.ButtonConfig{Variant: uikit.ButtonDanger, Small: true, Type: "submit"}) {
										Terminate
									}
								</form>
							</td>
						</tr>
					}
				</tbody>
			}
		}
	</section>
}
