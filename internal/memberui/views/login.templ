package views

import "github.com/Domene99/drun-dash/internal/uikit"

// Login renders the member sign-in page. It leads with the email/password form
// (the primary local path, ADR-0008 §5) — org slug + email + password POSTed to
// /login — and keeps the device-authorization flow below it for OIDC/SSO orgs:
// the user code the member confirms in the admin UI, a link to the verification
// page, and the [LoginPoll] approval poller that navigates home on approval.
// PasswordError, when set, explains a failed sign-in; DeviceError, when set,
// replaces the device section with why that flow could not start.
templ Login(data LoginData) {
	@Layout("Sign in", false) {
		@uikit.PageHeader(uikit.PageHeaderConfig{
			Title:       "Sign in",
			Description: "Sign in to your organization to launch and run agents.",
		})
		@uikit.Card(uikit.CardConfig{Title: "Email & password"}) {
			if data.PasswordError != "" {
				@uikit.Alert(uikit.AlertConfig{Variant: uikit.VariantDanger, Title: "Could not sign in"}) {
					{ data.PasswordError }
				}
			}
			<form method="post" action="/login">
				@uikit.Field(uikit.FieldConfig{Label: "Organization", For: "org_slug", Required: true, Help: "Your organization's slug (e.g. acme)."}) {
					@uikit.Input(uikit.InputConfig{
						ID:          "org_slug",
						Name:        "org_slug",
						Value:       data.OrgSlug,
						Placeholder: "acme",
						Attrs:       templ.Attributes{"autocomplete": "organization", "autofocus": true, "required": true},
					})
				}
				@uikit.Field(uikit.FieldConfig{Label: "Email", For: "email", Required: true}) {
					@uikit.Input(uikit.InputConfig{
						ID:          "email",
						Name:        "email",
						Type:        "email",
						Value:       data.Email,
						Placeholder: "you@example.com",
						Attrs:       templ.Attributes{"autocomplete": "email", "required": true},
					})
				}
				@uikit.Field(uikit.FieldConfig{Label: "Password", For: "password", Required: true}) {
					@uikit.Input(uikit.InputConfig{
						ID:    "password",
						Name:  "password",
						Type:  "password",
						Attrs: templ.Attributes{"autocomplete": "current-password", "required": true},
					})
				}
				@uikit.Button(uikit.ButtonConfig{Variant: uikit.ButtonPrimary, Type: "submit"}) {
					Sign in
				}
			</form>
		}
		@uikit.Card(uikit.CardConfig{Title: "Single sign-on"}) {
			if data.DeviceError != "" {
				@uikit.Alert(uikit.AlertConfig{Variant: uikit.VariantDanger, Title: "Could not start device sign-in"}) {
					{ data.DeviceError }
				}
				<p class="uk-muted">Use email &amp; password above, or reload the page to try again.</p>
			} else {
				<p class="uk-muted">For OIDC/SSO organizations: confirm the code below matches, then approve the request in the drun-dash admin UI.</p>
				<p class="mc-usercode">{ data.UserCode }</p>
				if data.VerificationURIComplete != "" {
					@uikit.ButtonLink(uikit.ButtonLinkConfig{
						Variant: uikit.ButtonSecondary,
						Href:    data.VerificationURIComplete,
						Attrs:   templ.Attributes{"target": "_blank", "rel": "noopener"},
					}) {
						Open the approval page
					}
				} else if data.VerificationURI != "" {
					<p>
						Go to
						<a href={ templ.SafeURL(data.VerificationURI) } target="_blank" rel="noopener">{ data.VerificationURI }</a>
						and enter the code.
					</p>
				}
				@LoginPoll(PollData{Pending: true, IntervalSeconds: data.IntervalSeconds, Message: "Waiting for approval…"})
			}
		}
	}
}

// LoginPoll renders the approval-poller fragment. While Pending it carries the
// HTMX attributes that re-request /login/poll on an interval and swap this same
// element, so polling continues until the server replies with a terminal
// fragment (no Pending) or an HX-Redirect to the home page.
templ LoginPoll(data PollData) {
	if data.Pending {
		<div
			id="poll"
			hx-get="/login/poll"
			hx-trigger={ triggerEvery(data.IntervalSeconds) }
			hx-target="#poll"
			hx-swap="outerHTML"
		>
			<p class="uk-muted">{ data.Message }</p>
		</div>
	} else {
		<div id="poll">
			<p class="uk-muted">{ data.Message }</p>
		</div>
	}
}
