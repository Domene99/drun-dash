package views

// Login renders the device-authorization sign-in page. It shows the user code
// the member confirms in the admin UI and a link to the verification page, then
// embeds the approval poller (via [LoginPoll]) which watches for the member to
// approve the request and, on success, navigates to the home page. When the
// flow could not be started it renders the error instead.
templ Login(data LoginData) {
	@Layout("Sign in", false) {
		<section class="card">
			<h1>Sign in</h1>
			if data.Error != "" {
				<p class="error" role="alert">{ data.Error }</p>
				<p class="muted">Reload the page to try again.</p>
			} else {
				<p class="muted">
					Approve this device in the drun-dash admin UI to sign in. Confirm the
					code below matches, then approve the request.
				</p>
				<p class="code">{ data.UserCode }</p>
				if data.VerificationURIComplete != "" {
					<p>
						<a href={ templ.SafeURL(data.VerificationURIComplete) } target="_blank" rel="noopener">
							Open the approval page
						</a>
					</p>
				} else if data.VerificationURI != "" {
					<p>
						Go to
						<a href={ templ.SafeURL(data.VerificationURI) } target="_blank" rel="noopener">{ data.VerificationURI }</a>
						and enter the code.
					</p>
				}
				@LoginPoll(PollData{Pending: true, IntervalSeconds: data.IntervalSeconds, Message: "Waiting for approval…"})
			}
		</section>
	}
}

// LoginPoll renders the approval-poller fragment. While Pending it carries the
// HTMX attributes that re-request /login/poll on an interval and swap this same
// element, so polling continues until the server replies with a terminal
// fragment (no Pending) or an HX-Redirect to the home page.
templ LoginPoll(data PollData) {
	if data.Pending {
		<div
			id="poll"
			hx-get="/login/poll"
			hx-trigger={ triggerEvery(data.IntervalSeconds) }
			hx-target="#poll"
			hx-swap="outerHTML"
		>
			<p class="muted">{ data.Message }</p>
		</div>
	} else {
		<div id="poll">
			<p class="muted">{ data.Message }</p>
		</div>
	}
}
