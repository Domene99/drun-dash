# Copy to .env and adjust as needed:
#   cp .env.example .env
#
# These values feed both docker-compose.yml and the connection strings
# documented in README.md. The defaults are fine for local development.

# --- PostgreSQL ---
POSTGRES_USER=drundash
POSTGRES_PASSWORD=drundash
POSTGRES_DB=drundash
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379
