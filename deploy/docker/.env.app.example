# Full-stack (application) environment for docker-compose.app.yml.
#
#   cp .env.app.example .env.app
#   docker compose --env-file .env.app -f docker-compose.app.yml up --build
#
# Every value here has a safe local-dev default that also lives inline in the
# compose file, so the stack runs with no edits. Override credentials and wire
# real secrets for anything beyond a laptop. Secrets below are PLACEHOLDERS —
# never commit real keys (.env.app is git-ignored; see .gitignore).
#
# IMPORTANT: DATABASE_URL / REDIS_URL use the compose *service* hostnames
# (`postgres`, `redis`), not `localhost` — the app containers reach the
# infrastructure over the compose network, not the host.

# =====================================================================
# Infrastructure (postgres + redis)
# =====================================================================
POSTGRES_USER=drundash
POSTGRES_PASSWORD=drundash          # dev only — change for anything shared
POSTGRES_DB=drundash
POSTGRES_PORT=5432                  # host port -> postgres:5432
REDIS_PORT=6379                     # host port -> redis:6379

# Connection strings used by migrate + every service (service DNS names).
DATABASE_URL=postgres://drundash:drundash@postgres:5432/drundash?sslmode=disable
REDIS_URL=redis://redis:6379/0

# =====================================================================
# Shared runtime (all services — internal/config)
# =====================================================================
LOG_LEVEL=info                     # debug | info | warn | error
ENV=development                    # development | staging | production

# =====================================================================
# control-plane (:8080)
# =====================================================================
HTTP_ADDR=:8080                    # in-container listen address
HTTP_PORT=8080                     # host port -> control-plane:8080

# --- Access-token (JWT) signing ---
CP_JWT_ISSUER=drun-dash
CP_JWT_AUDIENCE=drun-dash-api
CP_JWT_KID=dev
CP_ACCESS_TOKEN_TTL=15m
# Base64 of a 32-byte Ed25519 seed. Unset => a random per-process key that does
# NOT survive a restart. Production MUST set a stable seed:
#   openssl rand -base64 32
CP_JWT_SIGNING_SEED=

# --- OIDC (optional) ---
# When BOTH are set the auth routes (/auth/session, /auth/whoami) are mounted
# and startup runs live discovery against the issuer. Leave unset for a
# health-probes-only dev boot.
CP_OIDC_ISSUER=
CP_OIDC_CLIENT_ID=

# --- Session launch (ADR-0003) ---
# Base64 of a 32-byte Ed25519 seed for signing policy bundles. Unset => random.
CP_BUNDLE_SIGNING_SEED=
CP_BUNDLE_SIGNING_KID=dev
# Proxy base URL handed to launched sessions (compose service DNS name).
CP_PROXY_BASE_URL=http://llm-proxy:8081
CP_SESSION_TTL=60m

# =====================================================================
# llm-proxy (:8081)
# =====================================================================
PROXY_HTTP_ADDR=:8081              # in-container listen address
PROXY_HTTP_PORT=8081              # host port -> llm-proxy:8081
# Upstream provider base URL (scheme + host, optional path prefix).
LLM_UPSTREAM_BASE_URL=https://api.openai.com
# Master upstream credential. The dev EnvVault backend maps
# vault://dev/anthropic -> DRUNDASH_SECRET_ANTHROPIC. PLACEHOLDER — set a real
# key to actually forward calls; leave blank and the broker returns 502.
DRUNDASH_SECRET_ANTHROPIC=

# =====================================================================
# admin-ui (:8082)
# =====================================================================
ADMIN_UI_HTTP_ADDR=:8082           # in-container listen address
ADMIN_UI_HTTP_PORT=8082           # host port -> admin-ui:8082
# Control-plane base URL the UI calls (compose service DNS name).
CONTROL_PLANE_BASE_URL=http://control-plane:8080
